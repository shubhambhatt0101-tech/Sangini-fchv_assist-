<!DOCTYPE html>
<html style="color-scheme:dark" lang="ne">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FCHV_assist — Guest</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&family=DM+Mono:wght@400;500&family=Noto+Sans+Devanagari:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg:        #0A1428;
  --bg1:       #101D36;
  --bg2:       #15233F;
  --bg3:       #1B2C4D;
  --bg4:       #23375C;
  --line:      rgba(255,255,255,0.08);
  --line2:     rgba(255,255,255,0.14);
  --text:      #E6ECF7;
  --text2:     #B4C0D6;
  --muted:     #8794AF;
  --muted2:    #5D6A86;
  --red:       #E05252;
  --red-d:     #FF9A9A;
  --red-t:     rgba(224,82,82,0.12);
  --red-t2:    rgba(224,82,82,0.2);
  --teal:      #22A88D;
  --teal-t:    rgba(34,168,141,0.13);
  --amber:     #E0A23A;
  --amber-t:   rgba(224,162,58,0.13);
  --blue:      #4F9BE8;
  --blue-t:    rgba(79,155,232,0.13);
  --crit:      #FF6B6B;
  --low-c:    #2EC4A6;
  --med-c:    #E5A93A;
  --high-c:   #EF5B5B;
  --crit-c:   #FF6B6B;
  --r:    10px;
  --rsm:  7px;
  --rlg:  16px;
  --sh:   0 1px 3px rgba(0,0,0,0.45), 0 4px 14px rgba(0,0,0,0.35);
  --sh2:  0 2px 8px rgba(0,0,0,0.5), 0 8px 28px rgba(0,0,0,0.4);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }
body {
  font-family: 'DM Sans', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-thumb { background: var(--bg4); border-radius: 2px; }

.app {
  display: grid;
  grid-template-columns: 240px 1fr 320px;
  grid-template-rows: 50px 1fr;
  height: 100vh;
  max-width: 1480px;
  margin: 0 auto;
  width: 100%;
}

/* TOPBAR */
.topbar {
  grid-column: 1/-1;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 18px;
  background: var(--bg1);
  border-bottom: 1px solid var(--line);
  position: relative;
  z-index: 10;
}
.logo { display: flex; align-items: center; gap: 9px; flex-shrink: 0; }
.logo-mark {
  width: 28px; height: 28px; border-radius: 8px;
  background: var(--red);
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 600; color: #fff;
  font-family: 'DM Mono', monospace;
  position: relative; overflow: hidden;
}
.logo-mark::after {
  content: '';
  position: absolute; top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.15) 50%, transparent 60%);
  animation: shimmer 3s ease-in-out infinite;
}
@keyframes shimmer { 0%,100%{transform:translateX(-100%)rotate(45deg)} 50%{transform:translateX(100%)rotate(45deg)} }
.logo-name { font-size: 13px; font-weight: 600; letter-spacing: -0.3px; }
.logo-name span { color: var(--red); }
.logo-sub { font-size: 9px; color: var(--muted); letter-spacing: 0.06em; text-transform: uppercase; font-family: 'DM Mono', monospace; }
.hdiv { width: 1px; height: 20px; background: var(--line2); flex-shrink: 0; }

.nav-pills { display: flex; gap: 3px; }
.nav-pill {
  font-size: 11px; font-weight: 500; padding: 4px 10px;
  border-radius: 7px; border: 1px solid transparent;
  color: var(--muted); cursor: pointer; transition: all .15s;
  background: transparent;
}
.nav-pill:hover { color: var(--text2); background: var(--bg2); }
.nav-pill.active { color: var(--red); background: var(--red-t); border-color: var(--red-t2); }

/* Guest badge */
.guest-badge {
  display: flex; align-items: center; gap: 5px;
  font-size: 10.5px; font-weight: 600; padding: 4px 10px;
  border-radius: 20px;
  border: 1px solid var(--line2);
  color: var(--muted); background: var(--bg2);
  font-family: 'DM Mono', monospace;
}

/* Logout button */
.btn-logout {
  display: flex; align-items: center; gap: 5px;
  font-size: 11px; font-weight: 600; padding: 5px 11px;
  border-radius: 7px; border: 1.5px solid var(--line2);
  color: var(--text2); background: var(--bg2);
  cursor: pointer; transition: all .15s;
  font-family: 'DM Sans', sans-serif;
  text-decoration: none; white-space: nowrap;
}
.btn-logout:hover {
  border-color: var(--red-t2); background: var(--red-t); color: var(--red);
}
.btn-logout svg { width: 12px; height: 12px; transition: transform .15s; }
.btn-logout:hover svg { transform: translateX(2px); }

.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.status-pill {
  display: flex; align-items: center; gap: 5px;
  font-size: 10.5px; font-weight: 500; padding: 4px 10px;
  border-radius: 20px; border: 1px solid;
  font-family: 'DM Mono', monospace;
  transition: all .3s;
}
.status-pill.groq { border-color: var(--red-t2); color: var(--red); background: var(--red-t); }
.status-pill.offline { border-color: rgba(34,168,141,0.25); color: var(--teal); background: var(--teal-t); }
.status-pill.warn { border-color: rgba(224,162,58,0.25); color: var(--amber); background: var(--amber-t); }
.sdot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }
.status-pill.groq .sdot { background: var(--red); animation: pulse 2s ease-in-out infinite; }
.status-pill.offline .sdot { background: var(--teal); }
.status-pill.warn .sdot { background: var(--amber); animation: pulse 1s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.25;transform:scale(0.8)} }

.hack-tag {
  font-size: 9px; font-weight: 600; padding: 3px 8px; border-radius: 5px;
  color: var(--red); background: var(--red-t); border: 1px solid var(--red-t2);
  letter-spacing: 0.06em; font-family: 'DM Mono', monospace;
}

/* LEFT SIDEBAR */
.sidebar-left {
  border-right: 1px solid var(--line);
  background: var(--bg1);
  display: flex; flex-direction: column;
  overflow: hidden;
}
.sb-sec { padding: 14px 14px; border-bottom: 1px solid var(--line); }
.sb-lbl {
  font-size: 8px; font-weight: 600; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--muted2); margin-bottom: 10px;
  font-family: 'DM Mono', monospace;
}

.stat-g { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
.stat-c {
  background: var(--bg2); border: 1px solid var(--line);
  border-radius: var(--rsm); padding: 9px 10px;
  transition: border-color .2s;
}
.stat-c:hover { border-color: var(--line2); }
.stat-c.full { grid-column: 1/-1; }
.stat-n { font-size: 22px; font-weight: 600; color: var(--text); font-family: 'DM Mono', monospace; letter-spacing: -1px; line-height: 1; }
.stat-l { font-size: 9.5px; color: var(--muted); margin-top: 3px; }

.risk-rows { display: flex; flex-direction: column; gap: 8px; }
.risk-row { display: flex; flex-direction: column; gap: 3px; }
.risk-rh { display: flex; justify-content: space-between; }
.risk-rl { font-size: 11px; color: var(--text2); }
.risk-rv { font-size: 10px; font-family: 'DM Mono', monospace; }
.risk-rv.low  { color: var(--low-c); }
.risk-rv.med  { color: var(--med-c); }
.risk-rv.high { color: var(--high-c); }
.btrack { height: 2.5px; background: var(--bg3); border-radius: 2px; overflow: hidden; }
.bfill { height: 100%; border-radius: 2px; transition: width .8s cubic-bezier(.4,0,.2,1); }
.bfill.low  { background: var(--low-c); }
.bfill.med  { background: var(--med-c); }
.bfill.high { background: var(--high-c); }

.proto-scroll { flex: 1; overflow-y: auto; }
.proto-list { display: flex; flex-direction: column; gap: 3px; padding: 4px 0; }
.proto-item {
  display: flex; align-items: center; gap: 8px;
  padding: 7px 10px; border-radius: var(--rsm);
  border: 1px solid transparent; cursor: pointer;
  transition: all .15s; margin: 0 4px;
}
.proto-item:hover { background: var(--bg2); border-color: var(--line); }
.proto-item.active { background: var(--red-t); border-color: var(--red-t2); }
.proto-emoji { font-size: 14px; flex-shrink: 0; width: 20px; text-align: center; }
.proto-info { flex: 1; min-width: 0; }
.proto-nm { font-size: 11.5px; font-weight: 500; color: var(--text2); }
.proto-item.active .proto-nm { color: var(--red); font-weight: 600; }
.proto-ag { font-size: 9px; color: var(--muted); margin-top: 1px; font-family: 'DM Mono', monospace; }
.proto-cnt {
  font-size: 8.5px; font-weight: 600; padding: 2px 6px; border-radius: 5px;
  background: var(--bg3); color: var(--muted); border: 1px solid var(--line);
  font-family: 'DM Mono', monospace;
}

/* CHAT MAIN */
.chat-main { display: flex; flex-direction: column; overflow: hidden; background: var(--bg); }
.chat-feed {
  flex: 1; overflow-y: auto;
  padding: 18px 22px 10px;
  display: flex; flex-direction: column; gap: 14px;
  scroll-behavior: smooth;
}

.empty-state {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  text-align: center; gap: 14px; padding: 28px 20px;
  animation: fadeUp .4s ease;
}
@keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
.empty-icon {
  width: 68px; height: 68px; border-radius: 18px;
  background: var(--bg1); border: 1px solid var(--line2);
  display: flex; align-items: center; justify-content: center;
  font-size: 30px; box-shadow: var(--sh);
  animation: iconBob 3s ease-in-out infinite;
}
@keyframes iconBob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
.empty-h { font-size: 17px; font-weight: 500; color: var(--text); letter-spacing: -0.3px; font-family: 'Noto Sans Devanagari', sans-serif; }
.empty-p { font-size: 12px; color: var(--muted); line-height: 1.65; max-width: 320px; }
.hints { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px; }
.hint {
  font-family: 'Noto Sans Devanagari', sans-serif;
  font-size: 11px; padding: 5px 11px; border-radius: 14px;
  border: 1px solid var(--line2); color: var(--text2);
  background: var(--bg1); cursor: pointer; transition: all .15s;
}
.hint:hover { border-color: var(--red-t2); color: var(--red); background: var(--red-t); transform: translateY(-1px); }

.msg { display: flex; gap: 9px; animation: msgIn .22s cubic-bezier(.4,0,.2,1); }
@keyframes msgIn { from{opacity:0;transform:translateY(7px)} to{opacity:1;transform:translateY(0)} }
.msg.user { flex-direction: row-reverse; }
.avatar {
  width: 26px; height: 26px; border-radius: 7px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; margin-top: 2px; border: 1px solid var(--line);
}
.msg.user .avatar { background: var(--red-t); border-color: var(--red-t2); }
.msg.ai   .avatar { background: var(--teal-t); border-color: rgba(34,168,141,0.18); }
.msg.ai.svm .avatar { background: var(--blue-t); border-color: rgba(79,155,232,0.18); }
.msg.proto .avatar { background: var(--amber-t); border-color: rgba(224,162,58,0.2); }

.msg-body { max-width: calc(100% - 74px); display: flex; flex-direction: column; gap: 4px; }
.msg.user .msg-body { align-items: flex-end; }
.msg.ai   .msg-body { align-items: flex-start; }

.bubble {
  padding: 9px 13px; border-radius: var(--r);
  line-height: 1.72; word-break: break-word;
  font-family: 'Noto Sans Devanagari', sans-serif; font-size: 13.5px;
  box-shadow: var(--sh);
}
.msg.user .bubble { background: var(--bg1); border: 1px solid var(--line2); border-bottom-right-radius: 3px; }
.msg.ai   .bubble { background: var(--bg1); border: 1px solid var(--line2); border-bottom-left-radius: 3px; }
.msg.ai.svm .bubble { background: rgba(79,155,232,0.12); border-color: rgba(79,155,232,0.18); }

.pq-bubble {
  background: rgba(224,162,58,0.12);
  border: 1.5px solid rgba(224,162,58,0.22);
  border-radius: var(--r); border-bottom-left-radius: 3px;
  padding: 13px 14px; box-shadow: var(--sh);
  position: relative; overflow: hidden;
}
.pq-bubble::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--amber), transparent);
}
.pq-strip {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 8px;
}
.pq-label {
  font-size: 8.5px; font-weight: 600; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--amber);
  font-family: 'DM Mono', monospace;
}
.pq-voice-btn {
  display: flex; align-items: center; gap: 5px;
  font-size: 10px; font-weight: 500; padding: 4px 9px;
  border-radius: 12px; border: 1px solid rgba(224,162,58,0.25);
  color: var(--amber); background: rgba(224,162,58,0.07);
  cursor: pointer; transition: all .15s;
}
.pq-voice-btn:hover { background: rgba(224,162,58,0.14); border-color: rgba(224,162,58,0.4); }
.pq-voice-btn.speaking {
  color: var(--red); background: var(--red-t); border-color: var(--red-t2);
  animation: speakPulse 1.2s ease-in-out infinite;
}
@keyframes speakPulse { 0%,100%{opacity:1} 50%{opacity:0.6} }
.pq-voice-icon { font-size: 13px; }
.pq-text {
  font-size: 14px; color: var(--text); line-height: 1.65;
  font-family: 'Noto Sans Devanagari', sans-serif; margin-bottom: 11px;
}
.pq-btns { display: flex; gap: 8px; }
.pq-btn {
  flex: 1; padding: 9px 14px; border-radius: 9px; border: 1.5px solid;
  font-size: 13px; font-weight: 600; cursor: pointer; transition: all .18s;
  font-family: 'Noto Sans Devanagari', sans-serif; letter-spacing: 0.01em;
}
.pq-btn.yes { border-color: rgba(34,168,141,0.3); color: var(--teal); background: var(--teal-t); }
.pq-btn.yes:hover { background: rgba(34,168,141,0.14); border-color: var(--teal); transform: translateY(-1px); }
.pq-btn.no { border-color: var(--line2); color: var(--text2); background: var(--bg2); }
.pq-btn.no:hover { border-color: var(--red-t2); color: var(--red); transform: translateY(-1px); }
.pq-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none !important; }
.pq-btn.selected-yes { background: rgba(34,168,141,0.18); border-color: var(--teal); }
.pq-btn.selected-no { background: var(--red-t); border-color: var(--red-t2); color: var(--red); }

.pr-bubble {
  border-radius: var(--r); border-bottom-left-radius: 3px;
  padding: 14px 15px; box-shadow: var(--sh); border: 1.5px solid;
  position: relative; overflow: hidden;
}
.pr-bubble::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2.5px; }
.pr-bubble.critical { background: rgba(224,82,82,0.12); border-color: rgba(224,82,82,0.25); }
.pr-bubble.critical::before { background: var(--crit); }
.pr-bubble.high { background: rgba(224,82,82,0.12); border-color: rgba(224,82,82,0.22); }
.pr-bubble.high::before { background: var(--red); }
.pr-bubble.medium { background: rgba(224,162,58,0.12); border-color: rgba(224,162,58,0.22); }
.pr-bubble.medium::before { background: var(--amber); }
.pr-bubble.low { background: rgba(34,168,141,0.12); border-color: rgba(34,168,141,0.22); }
.pr-bubble.low::before { background: var(--teal); }
.pr-risk {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 9.5px; font-weight: 700; letter-spacing: 0.09em;
  text-transform: uppercase; padding: 3px 9px; border-radius: 6px;
  margin-bottom: 8px; font-family: 'DM Mono', monospace;
}
.pr-risk.critical { background: rgba(255,107,107,0.1); color: var(--crit); }
.pr-risk.high { background: var(--red-t2); color: var(--red); }
.pr-risk.medium { background: var(--amber-t); color: var(--amber); }
.pr-risk.low { background: var(--teal-t); color: var(--teal); }
.pr-action { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
.pr-advice { font-size: 13px; color: var(--text2); line-height: 1.68; font-family: 'Noto Sans Devanagari', sans-serif; }

.msg-footer { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; margin-top: 2px; }
.mtime { font-size: 9px; color: var(--muted2); font-family: 'DM Mono', monospace; }
.tag {
  font-size: 8.5px; font-weight: 600; padding: 2px 6px; border-radius: 5px;
  letter-spacing: 0.04em; font-family: 'DM Mono', monospace;
}
.t-groq   { background: var(--red-t2); color: var(--red); }
.t-svm    { background: var(--blue-t); color: var(--blue); }
.t-low    { background: var(--teal-t); color: var(--teal); }
.t-medium { background: var(--amber-t); color: var(--amber); }
.t-high   { background: var(--red-t); color: var(--red); }
.t-proto  { background: var(--amber-t); color: var(--amber); }
.t-text   { background: var(--blue-t); color: var(--blue); }
.t-el     { background: rgba(167,139,250,0.08); color: #A78BFA; }
.t-gtts   { background: var(--bg3); color: var(--muted); }

.thinking {
  padding: 10px 13px; border-radius: var(--r); border-bottom-left-radius: 3px;
  background: var(--bg1); border: 1px solid var(--line2);
  display: flex; gap: 5px; align-items: center; box-shadow: var(--sh);
}
.tdot { width: 5.5px; height: 5.5px; border-radius: 50%; background: var(--red); opacity: 0.2; }
.tdot:nth-child(1){animation:think 1.1s ease-in-out infinite 0.00s}
.tdot:nth-child(2){animation:think 1.1s ease-in-out infinite 0.18s}
.tdot:nth-child(3){animation:think 1.1s ease-in-out infinite 0.36s}
@keyframes think { 0%,80%,100%{opacity:0.15;transform:scale(1)} 40%{opacity:1;transform:scale(1.3)} }

/* INPUT BAR */
.input-bar {
  padding: 10px 16px 14px;
  border-top: 1px solid var(--line);
  background: var(--bg1);
}
.input-tabs { display: flex; gap: 3px; margin-bottom: 10px; align-items: center; }
.itab {
  display: flex; align-items: center; gap: 4px;
  font-size: 11px; font-weight: 500; padding: 4px 10px;
  border-radius: 7px; border: 1px solid transparent;
  color: var(--muted); cursor: pointer; transition: all .15s; background: transparent;
}
.itab:hover { color: var(--text2); background: var(--bg2); }
.itab.active { color: var(--red); background: var(--red-t); border-color: var(--red-t2); }

.voice-panel { display: flex; align-items: center; gap: 13px; }
.mic-wrap { position: relative; flex-shrink: 0; }
.mic-btn {
  width: 48px; height: 48px; border-radius: 14px;
  border: none; cursor: pointer; display: flex;
  align-items: center; justify-content: center; transition: all .15s;
}
.mic-btn.idle { background: var(--red); color: #fff; box-shadow: 0 4px 12px rgba(224,82,82,0.28); }
.mic-btn.idle:hover { transform: scale(1.05); box-shadow: 0 6px 18px rgba(224,82,82,0.38); }
.mic-btn.recording { background: var(--red-d); color: #fff; box-shadow: 0 0 0 0 rgba(224,82,82,0.5); animation: recPulse 1.4s ease-out infinite; }
.mic-btn.processing { background: var(--bg3); cursor: not-allowed; border: 1px solid var(--line2); color: var(--muted); }
@keyframes recPulse { 0%{box-shadow:0 0 0 0 rgba(224,82,82,0.5)} 70%{box-shadow:0 0 0 13px rgba(224,82,82,0)} 100%{box-shadow:0 0 0 0 rgba(224,82,82,0)} }
.mic-btn svg { width: 19px; height: 19px; fill: currentColor; pointer-events: none; }
.mic-btn.recording .i-mic { display: none; }
.mic-btn:not(.recording) .i-stop { display: none; }
.mic-btn.processing svg { display: none; }
.spin { display: none; width: 19px; height: 19px; border-radius: 50%; border: 2px solid var(--line2); border-top-color: var(--red); animation: spin .7s linear infinite; }
.mic-btn.processing .spin { display: block; }
@keyframes spin { to{transform:rotate(360deg)} }

.input-status { flex: 1; min-width: 0; }
.status-main { font-size: 13px; font-weight: 500; color: var(--text); }
.status-sub { font-size: 11px; color: var(--muted); margin-top: 2px; font-family: 'Noto Sans Devanagari', sans-serif; }
.rec-timer { font-size: 17px; font-weight: 600; color: var(--red); font-family: 'DM Mono', monospace; display: none; letter-spacing: -0.5px; }
.rec-timer.on { display: block; }
.waveform { display: flex; align-items: center; gap: 2px; height: 18px; opacity: 0; transition: opacity .3s; }
.waveform.on { opacity: 1; }
.wbar { width: 2.5px; border-radius: 2px; background: var(--red); height: 3px; transition: height .06s; }
.speak-wave { display: flex; align-items: center; gap: 2px; height: 18px; opacity: 0; transition: opacity .2s; }
.speak-wave.on { opacity: 1; }
.speak-wave span { display: block; width: 2.5px; border-radius: 2px; background: var(--teal); height: 3px; }
.speak-wave.on span:nth-child(1){animation:sw .7s ease-in-out infinite 0.00s}
.speak-wave.on span:nth-child(2){animation:sw .7s ease-in-out infinite 0.11s}
.speak-wave.on span:nth-child(3){animation:sw .7s ease-in-out infinite 0.22s}
.speak-wave.on span:nth-child(4){animation:sw .7s ease-in-out infinite 0.07s}
@keyframes sw { 0%,100%{height:3px} 50%{height:17px} }

.text-panel { display: none; flex-direction: column; gap: 6px; }
.text-panel.active { display: flex; }
.kw-chips { display: flex; flex-wrap: wrap; gap: 4px; }
.kw {
  font-family: 'Noto Sans Devanagari', sans-serif; font-size: 10px;
  padding: 3px 9px; border-radius: 12px; border: 1px solid var(--line2);
  color: var(--text2); background: var(--bg1); cursor: pointer; transition: all .13s;
}
.kw:hover { border-color: var(--red-t2); color: var(--red); background: var(--red-t); }
.text-row { display: flex; gap: 7px; align-items: flex-end; }
.ta {
  flex: 1; background: var(--bg1); border: 1.5px solid var(--line2);
  border-radius: 9px; padding: 8px 12px; color: var(--text);
  font-family: 'Noto Sans Devanagari', sans-serif; font-size: 14px;
  resize: none; outline: none; transition: border-color .16s;
  line-height: 1.6; min-height: 40px; max-height: 100px;
}
.ta:focus { border-color: rgba(224,82,82,0.35); }
.ta::placeholder { color: var(--muted2); }
.send-btn {
  width: 40px; height: 40px; border-radius: 11px;
  background: var(--red); border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  color: #fff; transition: all .14s;
  box-shadow: 0 2px 9px rgba(224,82,82,0.22);
}
.send-btn:hover { transform: scale(1.05); box-shadow: 0 4px 14px rgba(224,82,82,0.32); }
.send-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
.send-btn svg { width: 16px; height: 16px; fill: #fff; }

.file-panel { display: none; flex-direction: column; gap: 6px; }
.file-panel.active { display: flex; }
.drop-zone {
  border: 1.5px dashed var(--line2); border-radius: 9px;
  padding: 13px 16px; text-align: center; cursor: pointer;
  transition: all .15s; background: var(--bg1);
}
.drop-zone:hover,.drop-zone.over { border-color: var(--red-t2); background: var(--red-t); }
.drop-zone input { display: none; }
.dl { font-size: 12px; color: var(--muted); }
.dl strong { color: var(--text2); }
.dfmt { font-size: 9.5px; color: var(--muted2); margin-top: 1px; font-family: 'DM Mono', monospace; }
.fsel { display: none; align-items: center; gap: 8px; background: var(--bg2); border: 1px solid var(--line2); border-radius: 8px; padding: 8px 11px; }
.fsel.show { display: flex; }
.fsel-nm { flex: 1; font-size: 12px; color: var(--text2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fsend { background: var(--red); border: none; border-radius: 7px; padding: 5px 11px; color: #fff; font-size: 11px; font-weight: 600; cursor: pointer; }
.fclr { background: transparent; border: 1px solid var(--line2); border-radius: 7px; padding: 4px 8px; color: var(--muted); font-size: 11px; cursor: pointer; }

.btn-sm {
  font-size: 11px; font-weight: 500; padding: 4px 10px;
  border-radius: 6px; border: 1px solid var(--line2);
  color: var(--muted); background: transparent; cursor: pointer; transition: all .14s;
}
.btn-sm:hover { color: var(--red); border-color: var(--red-t2); background: var(--red-t); }

/* RIGHT PANEL */
.panel-right {
  border-left: 1px solid var(--line);
  background: var(--bg1);
  display: flex; flex-direction: column; overflow: hidden;
}
.panel-tabs { display: flex; border-bottom: 1px solid var(--line); flex-shrink: 0; }
.ptab {
  flex: 1; height: 36px; display: flex; align-items: center;
  justify-content: center; gap: 3px;
  font-size: 10px; font-weight: 500;
  color: var(--muted); cursor: pointer; transition: all .15s;
  border-bottom: 2px solid transparent;
}
.ptab:hover { color: var(--text2); }
.ptab.active { color: var(--red); border-bottom-color: var(--red); }
.tab-body { flex: 1; overflow-y: auto; padding: 13px; display: none; }
.tab-body.active { display: block; }

.wiz-empty { font-size: 12px; color: var(--muted); padding: 14px 0; text-align: center; line-height: 1.7; }
.wiz-card { background: var(--bg2); border: 1px solid var(--line2); border-radius: var(--r); padding: 13px; margin-bottom: 9px; }
.wiz-title { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 2px; }
.wiz-sub { font-size: 10.5px; color: var(--muted); margin-bottom: 11px; }
.wiz-steps { display: flex; flex-direction: column; gap: 5px; }
.wz { display: flex; align-items: flex-start; gap: 8px; padding: 7px 9px; border-radius: var(--rsm); border: 1px solid transparent; background: var(--bg1); transition: all .2s; }
.wz.done  { border-color: var(--line); background: var(--bg2); }
.wz.curr  { border-color: var(--red-t2); background: var(--red-t); }
.wz-num { width: 17px; height: 17px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 8.5px; font-weight: 700; margin-top: 1px; background: var(--bg3); color: var(--muted); border: 1px solid var(--line2); font-family: 'DM Mono', monospace; transition: all .2s; }
.wz.done .wz-num { background: var(--teal); color: #fff; border-color: var(--teal); }
.wz.curr .wz-num { background: var(--red); color: #fff; border-color: var(--red); }
.wz-q { font-size: 10.5px; color: var(--text2); line-height: 1.5; font-family: 'Noto Sans Devanagari', sans-serif; }
.wz.done .wz-q { color: var(--muted); }
.wz-a { font-size: 9.5px; font-weight: 600; margin-top: 2px; font-family: 'DM Mono', monospace; }
.wz-a.yes-a { color: var(--teal); }
.wz-a.no-a  { color: var(--red); }

.ref-empty { font-size: 12px; color: var(--muted); padding: 14px 0; text-align: center; line-height: 1.7; }
.urg-banner { display: flex; align-items: center; gap: 9px; padding: 10px 12px; border-radius: var(--r); border: 1.5px solid; margin-bottom: 9px; position: relative; overflow: hidden; }
.urg-banner::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; }
.urg-banner.high,.urg-banner.critical { background: rgba(224,82,82,0.12); border-color: rgba(224,82,82,0.25); }
.urg-banner.high::before,.urg-banner.critical::before { background: var(--red); }
.urg-banner.medium { background: rgba(224,162,58,0.12); border-color: rgba(224,162,58,0.25); }
.urg-banner.medium::before { background: var(--amber); }
.urg-banner.low { background: rgba(34,168,141,0.12); border-color: rgba(34,168,141,0.25); }
.urg-banner.low::before { background: var(--teal); }
.urg-icon { font-size: 18px; flex-shrink: 0; }
.urg-label { font-size: 10px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; font-family: 'DM Mono', monospace; }
.urg-banner.high .urg-label,.urg-banner.critical .urg-label { color: var(--high-c); }
.urg-banner.medium .urg-label { color: var(--med-c); }
.urg-banner.low .urg-label { color: var(--low-c); }
.urg-ne { font-size: 12px; color: var(--text); margin-top: 2px; font-family: 'Noto Sans Devanagari', sans-serif; }
.hosp-card { background: var(--bg2); border: 1px solid var(--line2); border-radius: var(--r); padding: 12px; margin-bottom: 9px; }
.hosp-name { font-size: 12.5px; font-weight: 600; color: var(--text); margin-bottom: 5px; line-height: 1.3; }
.hosp-bgs { display: flex; flex-wrap: wrap; gap: 3px; margin-bottom: 8px; }
.hb { font-size: 8.5px; font-weight: 600; padding: 2px 6px; border-radius: 5px; border: 1px solid; font-family: 'DM Mono', monospace; }
.hb-e { background: rgba(224,82,82,0.07); border-color: rgba(224,82,82,0.22); color: var(--high-c); }
.hb-a { background: var(--blue-t); border-color: rgba(79,155,232,0.22); color: var(--blue); }
.hb-ok  { background: var(--teal-t); border-color: rgba(34,168,141,0.22); color: var(--teal); }
.hb-ltd { background: var(--amber-t); border-color: rgba(224,162,58,0.22); color: var(--amber); }
.hb-full{ background: var(--red-t); border-color: var(--red-t2); color: var(--red); }
.hosp-stats { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 5px; margin-bottom: 8px; }
.hs { background: var(--bg1); border-radius: var(--rsm); border: 1px solid var(--line); padding: 6px 8px; text-align: center; }
.hs-v { font-size: 13px; font-weight: 600; color: var(--text); font-family: 'DM Mono', monospace; }
.hs-l { font-size: 9px; color: var(--muted); margin-top: 1px; }
.hosp-ct { font-size: 10.5px; color: var(--text2); margin-bottom: 5px; }
.hosp-rd { font-size: 10px; color: var(--muted); margin-bottom: 5px; }
.hosp-sp { display: flex; flex-wrap: wrap; gap: 3px; }
.hsp { font-size: 9px; padding: 2px 6px; border-radius: 4px; background: var(--blue-t); border: 1px solid rgba(79,155,232,0.13); color: var(--blue); }
.reas-box { background: rgba(224,162,58,0.12); border: 1px solid rgba(224,162,58,0.22); border-radius: var(--rsm); padding: 8px 10px; margin-bottom: 8px; }
.reas-lbl { font-size: 8px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--amber); margin-bottom: 2px; font-family: 'DM Mono', monospace; }
.reas-txt { font-size: 11px; color: var(--text2); font-family: 'Noto Sans Devanagari', sans-serif; line-height: 1.5; }
.ref-acts { display: flex; flex-direction: column; gap: 5px; margin-bottom: 8px; }
.ref-act { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: var(--rsm); border: 1px solid var(--line); background: var(--bg1); cursor: pointer; transition: all .14s; box-shadow: var(--sh); }
.ref-act:hover { box-shadow: var(--sh2); border-color: var(--line2); transform: translateY(-1px); }
.ref-act.urg { border-color: rgba(224,82,82,0.2); background: rgba(224,82,82,0.12); }
.ref-act.urg:hover { border-color: rgba(224,82,82,0.35); }
.ra-ic { font-size: 15px; flex-shrink: 0; }
.ra-tx { flex: 1; min-width: 0; }
.ra-lb { font-size: 11.5px; font-weight: 600; color: var(--text); }
.ref-act.urg .ra-lb { color: var(--high-c); }
.ra-sb { font-size: 9.5px; color: var(--muted); margin-top: 1px; }
.ra-arr { font-size: 11px; color: var(--muted2); flex-shrink: 0; }
.ref-alt { font-size: 10.5px; color: var(--muted); padding: 6px 9px; background: var(--bg2); border-radius: var(--rsm); border: 1px solid var(--line); margin-top: 5px; }
.ref-alt strong { color: var(--text2); }

.asec { margin-bottom: 15px; }
.asec-title { font-size: 8px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted2); margin-bottom: 8px; font-family: 'DM Mono', monospace; }
.kpi-g { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
.kpi { background: var(--bg2); border: 1px solid var(--line); border-radius: var(--rsm); padding: 9px 11px; }
.kpi-v { font-size: 21px; font-weight: 600; color: var(--text); font-family: 'DM Mono', monospace; letter-spacing: -0.5px; }
.kpi-l { font-size: 9px; color: var(--muted); margin-top: 2px; }
.donut-row { display: flex; align-items: center; gap: 10px; background: var(--bg2); border: 1px solid var(--line); border-radius: var(--rsm); padding: 11px; }
.dl-item { display: flex; align-items: center; gap: 5px; font-size: 10.5px; }
.dl-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.dl-lb { color: var(--text2); flex: 1; }
.dl-v { color: var(--text); font-weight: 600; font-family: 'DM Mono', monospace; font-size: 10.5px; }
.bar-chart { background: var(--bg2); border: 1px solid var(--line); border-radius: var(--rsm); padding: 9px; }
.bar-inner { display: flex; align-items: flex-end; gap: 3px; height: 52px; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.bar-fill2 { width: 100%; border-radius: 3px 3px 0 0; background: var(--red); opacity: 0.55; min-height: 2px; transition: height .6s cubic-bezier(.4,0,.2,1); }
.bar-lbl2 { font-size: 7.5px; color: var(--muted); font-family: 'DM Mono', monospace; }
.proto-stats { display: flex; flex-direction: column; gap: 4px; }
.ps-row { display: flex; align-items: center; gap: 7px; padding: 6px 8px; background: var(--bg2); border: 1px solid var(--line); border-radius: var(--rsm); }
.ps-nm { font-size: 10.5px; color: var(--text2); flex: 1; font-family: 'Noto Sans Devanagari', sans-serif; }
.ps-v { font-size: 10.5px; font-weight: 600; color: var(--red); font-family: 'DM Mono', monospace; }

.log-list { display: flex; flex-direction: column; gap: 4px; }
.log-item { background: var(--bg2); border: 1px solid var(--line); border-radius: var(--rsm); padding: 7px 9px; transition: border-color .14s; cursor: default; }
.log-item:hover { border-color: var(--line2); }
.log-top { display: flex; align-items: center; gap: 4px; margin-bottom: 2px; }
.ldot { width: 5.5px; height: 5.5px; border-radius: 50%; flex-shrink: 0; }
.ldot.low { background: var(--low-c); }
.ldot.medium { background: var(--med-c); }
.ldot.high   { background: var(--high-c); }
.lpred { font-size: 8.5px; font-weight: 700; letter-spacing: 0.05em; font-family: 'DM Mono', monospace; }
.lpred.low    { color: var(--low-c); }
.lpred.medium { color: var(--med-c); }
.lpred.high   { color: var(--high-c); }
.ltime { font-size: 8.5px; color: var(--muted2); margin-left: auto; font-family: 'DM Mono', monospace; }
.lproto { font-size: 8.5px; color: var(--amber); font-family: 'DM Mono', monospace; }
.ltxt { font-size: 10.5px; color: var(--text2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: 'Noto Sans Devanagari', sans-serif; }

.toast {
  position: fixed; bottom: 72px; left: 50%; transform: translateX(-50%) translateY(0);
  background: var(--bg1); color: var(--text);
  border: 1px solid var(--line2); font-size: 12px;
  padding: 7px 14px; border-radius: 9px; z-index: 1000;
  display: none; max-width: 85vw; text-align: center;
  box-shadow: var(--sh2);
}
.toast.on { display: block; animation: toastIn .2s ease; }
.toast.err { border-color: var(--red-t2); background: rgba(224,82,82,0.12); color: var(--red); }
@keyframes toastIn { from{opacity:0;transform:translateX(-50%) translateY(8px)} to{opacity:1;transform:translateX(-50%) translateY(0)} }

@media(max-width:1050px){ .app{grid-template-columns:196px 1fr 280px;} }
@media(max-width:780px){ .app{grid-template-columns:1fr;grid-template-rows:50px 1fr auto;} .sidebar-left{display:none;} .panel-right{max-height:240px;} }
</style>
</head>
<body>
<div class="app">

<!-- TOPBAR -->
<div class="topbar">
  <div class="logo">
    <div class="logo-mark">F</div>
    <div>
      <div class="logo-name">FCHV<span>_assist</span></div>
      <div class="logo-sub">FCHV · IMNCI Digital System</div>
    </div>
  </div>
  <div class="hdiv"></div>
  <div class="nav-pills">
    <div class="nav-pill active" onclick="setView('chat')">💬 Consultation</div>
    <div class="nav-pill" onclick="setView('protocol')">🩺 IMNCI Wizard</div>
  </div>
  <div class="topbar-right">
    <div class="guest-badge">👤 Guest</div>
    <div class="status-pill warn" id="statusPill">
      <div class="sdot"></div>
      <span id="statusTxt">Connecting...</span>
    </div>
    <div class="hack-tag">Harvard 2026</div>
    <!-- LOGOUT BUTTON — redirects to login.html -->
    <a href="/login" class="btn-logout" title="लगआउट गर्नुहोस्">
      लगआउट
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
        <polyline points="16 17 21 12 16 7"/>
        <line x1="21" y1="12" x2="9" y2="12"/>
      </svg>
    </a>
  </div>
</div>

<!-- LEFT SIDEBAR -->
<div class="sidebar-left">
  <div class="sb-sec">
    <div class="sb-lbl">Session Stats</div>
    <div class="stat-g">
      <div class="stat-c"><div class="stat-n" id="sTotal">0</div><div class="stat-l">Consultations</div></div>
      <div class="stat-c"><div class="stat-n" id="sMs">—</div><div class="stat-l">Avg response</div></div>
      <div class="stat-c full"><div class="stat-n" id="sAI">0</div><div class="stat-l">AI-assisted cases</div></div>
    </div>
  </div>
  <div class="sb-sec">
    <div class="sb-lbl">Risk Distribution</div>
    <div class="risk-rows">
      <div class="risk-row">
        <div class="risk-rh"><span class="risk-rl">Low 🟢</span><span class="risk-rv low" id="rLN">0</span></div>
        <div class="btrack"><div class="bfill low" id="rL" style="width:0%"></div></div>
      </div>
      <div class="risk-row">
        <div class="risk-rh"><span class="risk-rl">Medium 🟡</span><span class="risk-rv med" id="rMN">0</span></div>
        <div class="btrack"><div class="bfill med" id="rM" style="width:0%"></div></div>
      </div>
      <div class="risk-row">
        <div class="risk-rh"><span class="risk-rl">High 🔴</span><span class="risk-rv high" id="rHN">0</span></div>
        <div class="btrack"><div class="bfill high" id="rH" style="width:0%"></div></div>
      </div>
    </div>
  </div>
  <div class="sb-sec" style="flex:1;overflow:hidden;display:flex;flex-direction:column;padding-bottom:0;">
    <div class="sb-lbl">IMNCI Protocols</div>
    <div class="proto-scroll">
      <div class="proto-list" id="protoList"></div>
    </div>
  </div>
</div>

<!-- CHAT MAIN -->
<div class="chat-main">
  <div class="chat-feed" id="chatFeed">
    <div class="empty-state" id="emptyState">
      <div class="empty-icon">🏥</div>
      <h2 class="empty-h">आफ्नो स्वास्थ्य प्रश्न सोध्नुहोस्</h2>
      <p class="empty-p">Voice, text, or file — AI gives IMNCI-guided advice in Nepali. Use the Protocol Wizard for step-by-step diagnosis with voice guidance.</p>
      <div class="hints">
        <div class="hint" onclick="useHint(this)">बच्चालाई ज्वरो छ</div>
        <div class="hint" onclick="useHint(this)">बच्चालाई दिसा भइरहेको छ</div>
        <div class="hint" onclick="useHint(this)">बच्चाले खाना छाडेको छ</div>
        <div class="hint" onclick="useHint(this)">बच्चाले छिटो सास फेर्छ</div>
        <div class="hint" onclick="useHint(this)">बच्चाको कान दुख्छ</div>
        <div class="hint" onclick="useHint(this)">रगत बगेको छ</div>
      </div>
    </div>
  </div>

  <div class="input-bar">
    <div class="input-tabs">
      <button class="itab active" id="tabVoice" onclick="setMode('voice')">🎙 Voice</button>
      <button class="itab" id="tabText"  onclick="setMode('text')">⌨️ Text</button>
      <button class="itab" id="tabFile"  onclick="setMode('file')">📁 Upload</button>
      <div style="margin-left:auto"><button class="btn-sm" onclick="clearChat()">↺ Clear</button></div>
    </div>

    <!-- Voice -->
    <div id="voicePanel" class="voice-panel">
      <div class="mic-wrap">
        <button class="mic-btn idle" id="micBtn" onclick="toggleRec()">
          <svg class="i-mic" viewBox="0 0 24 24"><path d="M12 1a4 4 0 0 1 4 4v6a4 4 0 0 1-8 0V5a4 4 0 0 1 4-4zm-7 10a7 7 0 0 0 14 0h-2a5 5 0 0 1-10 0H5zm7 9v-2.07A8 8 0 0 0 19.93 11H18a6 6 0 0 1-12 0H4.07A8 8 0 0 0 12 17.93V20h-3v2h8v-2h-3z"/></svg>
          <svg class="i-stop" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2"/></svg>
          <div class="spin"></div>
        </button>
      </div>
      <div class="input-status">
        <div style="display:flex;align-items:center;gap:7px;">
          <div class="waveform" id="waveform">
            <div class="wbar" id="b0"></div><div class="wbar" id="b1"></div><div class="wbar" id="b2"></div><div class="wbar" id="b3"></div>
            <div class="wbar" id="b4"></div><div class="wbar" id="b5"></div><div class="wbar" id="b6"></div><div class="wbar" id="b7"></div>
          </div>
          <div class="rec-timer" id="recTimer">0:00</div>
          <div class="speak-wave" id="speakWave"><span></span><span></span><span></span><span></span></div>
          <span class="status-main" id="statusMain">Press mic to speak</span>
        </div>
        <div class="status-sub" id="statusSub">बोल्न सुरु गर्नुहोस् · Speak in Nepali</div>
      </div>
    </div>

    <!-- Text -->
    <div id="textPanel" class="text-panel">
      <div class="kw-chips" id="kwChips"></div>
      <div class="text-row">
        <textarea class="ta" id="nepaliInput" rows="2" placeholder="यहाँ नेपालीमा लेख्नुहोस्..." onkeydown="handleTK(event)"></textarea>
        <button class="send-btn" onclick="sendText()">
          <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
        </button>
      </div>
    </div>

    <!-- File -->
    <div id="filePanel" class="file-panel">
      <div class="drop-zone" id="dropZone" onclick="document.getElementById('fileIn').click()" ondragover="dOver(event)" ondragleave="dLeave(event)" ondrop="dDrop(event)">
        <input type="file" id="fileIn" accept="audio/*,.wav,.mp3,.webm,.ogg,.m4a,.flac" onchange="fileSel(event)">
        <div class="dl"><strong>Click to browse</strong> or drag &amp; drop audio</div>
        <div class="dfmt">WAV · MP3 · WebM · OGG · M4A · FLAC</div>
      </div>
      <div class="fsel" id="fileSel">
        <span>🎵</span>
        <span class="fsel-nm" id="fselNm">—</span>
        <button class="fclr" onclick="clearFile()">✕</button>
        <button class="fsend" onclick="sendFile()">Analyze →</button>
      </div>
    </div>
  </div>
</div>

<!-- RIGHT PANEL -->
<div class="panel-right">
  <div class="panel-tabs">
    <div class="ptab active" onclick="switchTab('referral')">🏥 Referral</div>
    <div class="ptab" onclick="switchTab('wizard')">🩺 Wizard</div>
    <div class="ptab" onclick="switchTab('analytics')">📊 Stats</div>
    <div class="ptab" onclick="switchTab('log')">📋 Log</div>
  </div>

  <div class="tab-body active" id="tab-referral">
    <div class="ref-empty" id="refEmpty">🏥 Complete a consultation to see hospital referral.<br><br><span style="font-size:10.5px;color:var(--muted2)">Referral auto-populates after each submission.</span></div>
    <div id="refContent" style="display:none"></div>
  </div>

  <div class="tab-body" id="tab-wizard">
    <div class="wiz-empty" id="wizEmpty">🩺 Select an IMNCI condition from the sidebar to begin step-by-step assessment with voice guidance.<br><br>Or speak/type symptoms — the system auto-detects the condition.</div>
    <div id="wizContent" style="display:none"></div>
  </div>

  <div class="tab-body" id="tab-analytics">
    <div class="asec">
      <div class="asec-title">Risk Breakdown</div>
      <div class="donut-row">
        <svg width="64" height="64" viewBox="0 0 64 64">
          <circle cx="32" cy="32" r="22" fill="none" stroke-width="8" stroke="var(--bg3)"/>
          <circle id="doH" cx="32" cy="32" r="22" fill="none" stroke-width="8" stroke="#B83232" stroke-dasharray="0 138" transform="rotate(-90 32 32)" style="transition:stroke-dasharray .7s cubic-bezier(.4,0,.2,1)"/>
          <circle id="doM" cx="32" cy="32" r="22" fill="none" stroke-width="8" stroke="#A8710D" stroke-dasharray="0 138" transform="rotate(-90 32 32)" style="transition:stroke-dasharray .7s cubic-bezier(.4,0,.2,1)"/>
          <circle id="doL" cx="32" cy="32" r="22" fill="none" stroke-width="8" stroke="#0C7A68" stroke-dasharray="0 138" transform="rotate(-90 32 32)" style="transition:stroke-dasharray .7s cubic-bezier(.4,0,.2,1)"/>
          <text x="32" y="36" text-anchor="middle" font-size="11" font-weight="600" fill="#18160F" id="doC">0</text>
        </svg>
        <div style="flex:1;display:flex;flex-direction:column;gap:5px">
          <div class="dl-item"><div class="dl-dot" style="background:var(--low-c)"></div><span class="dl-lb">Low</span><span class="dl-v" id="dlL">0</span></div>
          <div class="dl-item"><div class="dl-dot" style="background:var(--med-c)"></div><span class="dl-lb">Medium</span><span class="dl-v" id="dlM">0</span></div>
          <div class="dl-item"><div class="dl-dot" style="background:var(--high-c)"></div><span class="dl-lb">High</span><span class="dl-v" id="dlH">0</span></div>
        </div>
      </div>
    </div>
    <div class="asec">
      <div class="asec-title">KPIs</div>
      <div class="kpi-g">
        <div class="kpi"><div class="kpi-v" id="kT">0</div><div class="kpi-l">Consultations</div></div>
        <div class="kpi"><div class="kpi-v" id="kA">—</div><div class="kpi-l">Avg ms</div></div>
        <div class="kpi"><div class="kpi-v" id="kAI">0</div><div class="kpi-l">AI-assisted</div></div>
        <div class="kpi"><div class="kpi-v" id="kSV">0</div><div class="kpi-l">SVM-only</div></div>
      </div>
    </div>
    <div class="asec">
      <div class="asec-title">Activity (7d)</div>
      <div class="bar-chart"><div class="bar-inner" id="barChart"></div></div>
    </div>
    <div class="asec">
      <div class="asec-title">Protocol Usage</div>
      <div class="proto-stats" id="protoStats"><div style="font-size:11px;color:var(--muted)">No protocol data yet.</div></div>
    </div>
  </div>

  <div class="tab-body" id="tab-log">
    <div class="log-list" id="logList"><div style="font-size:11.5px;color:var(--muted);padding:8px">No sessions yet.</div></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const $ = id => document.getElementById(id);
let mediaRecorder=null, audioChunks=[], timerInt=null, waveInt=null;
let seconds=0, isRecording=false, isProcessing=false;
let audioCtx=null, analyser=null, micStream=null;
let currentAudio=null, conversationHistory=[], msgN=0;
let currentMode='voice', selectedFile=null;
let activeProtocol=null, protocolAnswers={}, protocolStepIdx=0;
let allProtocols = {};

const PROTO_ICONS = {
  danger_signs:'⚠️', neonatal_sepsis:'👶', diarrhea:'💧',
  fever:'🌡️', cough:'🫁', ear_problem:'👂',
  malnutrition:'⚖️', eye_problem:'👁️', skin_problem:'🩹'
};
const KW_LIST = [
  'टाउको दुख्छ','ज्वरो छ','पेट दुख्छ','दिसा भयो','सास गाह्रो',
  'बच्चाले खान छाड्यो','कम्पन आयो','कान दुख्छ','आँखा रातो','छाला खटिरा'
];
const TTS_MAP = {
  'elevenlabs_ne':'ElevenLabs 🇳🇵','openai_en':'OpenAI TTS 🇬🇧',
  'piper_offline':'Piper 📱','gtts_ne':'gTTS 🇳🇵','gtts_en':'gTTS 🇬🇧',
  'prerendered':'Pre-rendered','none':'None'
};

async function init() {
  setupKW();
  setMode('voice');
  await loadProtocols();
  await checkMode();
  await loadAnalytics();
  setInterval(checkMode, 15000);
  setInterval(loadAnalytics, 30000);
}

async function loadProtocols() {
  try {
    allProtocols = await fetch('/protocols').then(r=>r.json());
    renderProtoList();
  } catch(e) { console.warn('Protocols:', e); }
}

async function fetchJson(url, options = {}) {
  const resp = await fetch(url, options);
  const data = await resp.json().catch(() => null);
  if (!resp.ok) {
    throw new Error((data && (data.error || data.message)) || `HTTP ${resp.status}`);
  }
  return data;
}

function renderProtoList() {
  $('protoList').innerHTML = Object.entries(allProtocols).map(([k,v]) => `
    <div class="proto-item" id="pi-${k}" onclick="selectProtocol('${k}')">
      <div class="proto-emoji">${PROTO_ICONS[k]||'🔬'}</div>
      <div class="proto-info">
        <div class="proto-nm">${v.label}</div>
        <div class="proto-ag">${v.age_group} · ${v.step_count} steps</div>
      </div>
      <div class="proto-cnt">${v.step_count}</div>
    </div>`).join('');
}

async function checkMode() {
  try {
    const s = await fetch('/status').then(r=>r.json());
    const p = $('statusPill'), t = $('statusTxt');
    if (s.ai_available) { p.className='status-pill groq'; t.textContent='⚡ Groq Online'; }
    else if (s.online && !s.groq_configured) { p.className='status-pill warn'; t.textContent='⚠ Set Groq Key'; }
    else { p.className='status-pill offline'; t.textContent='📊 Offline SVM'; }
  } catch { $('statusPill').className='status-pill offline'; $('statusTxt').textContent='Offline'; }
}

const _ttsCache = {};
let _protoAudio = null;

async function speakProtocolQuestion(text, btnEl) {
  if (btnEl && btnEl.classList.contains('speaking')) { stopProtoAudio(); resetProtoBtn(btnEl); return; }
  stopProtoAudio();
  if (currentAudio) { currentAudio.pause(); currentAudio = null; }
  document.querySelectorAll('.pq-voice-btn').forEach(b => resetProtoBtn(b));
  if (btnEl) { btnEl.classList.add('speaking'); btnEl.innerHTML = '<span class="pq-voice-icon">🔊</span><span>बन्द गर्नुहोस्</span>'; }
  const done = () => { if (btnEl) resetProtoBtn(btnEl); };
  if (_ttsCache[text]) { playProtoAudio(_ttsCache[text], done); return; }
  try {
    const resp = await fetch('/tts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text, lang: 'ne' }) });
    if (resp.ok) { const blob = await resp.blob(); const url = URL.createObjectURL(blob); _ttsCache[text] = url; playProtoAudio(url, done); return; }
  } catch(e) {}
  done();
}

function playProtoAudio(url, done) {
  _protoAudio = new Audio(url);
  _protoAudio.onended = done; _protoAudio.onerror = done;
  _protoAudio.play().catch(done);
}
function stopProtoAudio() { if (_protoAudio) { _protoAudio.pause(); _protoAudio.currentTime = 0; _protoAudio = null; } }
function resetProtoBtn(btn) { if (!btn) return; btn.classList.remove('speaking'); btn.innerHTML = '<span class="pq-voice-icon">🔊</span><span>सुन्नुहोस्</span>'; }

function selectProtocol(condition) {
  activeProtocol = condition; protocolAnswers = {}; protocolStepIdx = 0;
  document.querySelectorAll('.proto-item').forEach(p => p.classList.remove('active'));
  const pi = $('pi-'+condition); if (pi) pi.classList.add('active');
  switchTab('wizard'); renderWizard();
  askNextProtocolQuestion(condition);
}

async function askNextProtocolQuestion(condition) {
  try {
    const r = await fetchJson('/protocol', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({condition, answers: protocolAnswers}) });
    if (r.next_question) showProtocolQuestion(r.next_question, condition);
    else if (r.result) showProtocolResult(r.result);
    renderWizard(r);
  } catch(e) { toast('Protocol error: '+e.message, true); }
}

function showProtocolQuestion(nq, condition) {
  hideEmpty();
  const qId = 'pq-'+(++msgN); const btnId = 'pvb-'+qId;
  $('chatFeed').insertAdjacentHTML('beforeend', `
    <div class="msg proto" id="${qId}">
      <div class="avatar">🩺</div>
      <div class="msg-body">
        <div class="pq-bubble">
          <div class="pq-strip">
            <div class="pq-label">🩺 IMNCI · ${nq.condition_label||condition} · चरण ${protocolStepIdx+1}</div>
            <button class="pq-voice-btn" id="${btnId}" onclick="speakProtocolQuestion(${JSON.stringify(nq.question)}, this)">
              <span class="pq-voice-icon">🔊</span><span>सुन्नुहोस्</span>
            </button>
          </div>
          <div class="pq-text">${esc(nq.question)}</div>
          <div class="pq-btns">
            <button class="pq-btn yes" onclick="answerProtocol('${condition}','${nq.step_id}',true,this)">✓ हो (Yes)</button>
            <button class="pq-btn no"  onclick="answerProtocol('${condition}','${nq.step_id}',false,this)">✗ होइन (No)</button>
          </div>
        </div>
        <div class="msg-footer"><span class="tag t-proto">📋 Protocol</span><span class="mtime">${now()}</span></div>
      </div>
    </div>`);
  scrollBot();
  setTimeout(() => { const btn = $(btnId); if (btn) speakProtocolQuestion(nq.question, btn); }, 350);
}

async function answerProtocol(condition, stepId, answer, btn) {
  const btns = btn.closest('.pq-btns').querySelectorAll('button');
  btns.forEach(b => {
    b.disabled = true;
    const isThis = (answer && b.classList.contains('yes')) || (!answer && b.classList.contains('no'));
    b.className = 'pq-btn ' + (b.classList.contains('yes')?'yes':'no') + (isThis ? (answer?' selected-yes':' selected-no') : '');
  });
  stopProtoAudio(); if (currentAudio) { currentAudio.pause(); currentAudio = null; }
  document.querySelectorAll('.pq-voice-btn').forEach(b => resetProtoBtn(b));
  addBubble('user', answer ? '✓ हो (Yes)' : '✗ होइन (No)', []);
  protocolAnswers[stepId] = answer; protocolStepIdx++;
  const thinkId = addThinking();
  await new Promise(r => setTimeout(r, 450));
  removeEl(thinkId);
  await askNextProtocolQuestion(condition);
}

function showProtocolResult(result) {
  if (!result) return;
  const res = result.result || {}; const risk = res.risk || 'low'; const action = result.action_meta || {};
  const riskEmoji = risk==='critical'?'🚨':risk==='high'?'🔴':risk==='medium'?'🟡':'🟢';
  addBubble('ai', '', [], false, null, null, `
    <div class="pr-bubble ${risk}">
      <div class="pr-risk ${risk}">${riskEmoji} ${risk.toUpperCase()} · ${result.condition_label_en||''}</div>
      <div class="pr-action">${esc(action.label||'')}</div>
      <div class="pr-advice">${esc(res.advice||'')}</div>
    </div>
  `, ['proto']);
  if (res.advice) setTimeout(() => speakProtocolQuestion(res.advice, null), 200);
  activeProtocol = null;
  document.querySelectorAll('.proto-item').forEach(p => p.classList.remove('active'));
}

function renderWizard(data) {
  const we = $('wizEmpty'), wc = $('wizContent');
  if (!activeProtocol && (!data || !data.result)) { we.style.display=''; wc.style.display='none'; return; }
  we.style.display='none'; wc.style.display='block';
  const proto = allProtocols[activeProtocol] || {};
  const steps = (data && data.result && data.result.protocol && data.result.protocol.steps) || [];
  const stepsHtml = steps.map((s,i) => {
    const done = protocolAnswers.hasOwnProperty(s.id); const curr = !done && i === protocolStepIdx;
    const ans = protocolAnswers[s.id];
    return `<div class="wz ${done?'done':curr?'curr':''}">
      <div class="wz-num">${done?'✓':(i+1)}</div>
      <div><div class="wz-q">${esc(s.q)}</div>${done?`<div class="wz-a ${ans?'yes-a':'no-a'}">${ans?'→ हो':'→ होइन'}</div>`:''}</div>
    </div>`;
  }).join('');
  wc.innerHTML = `
    <div class="wiz-card">
      <div class="wiz-title">${PROTO_ICONS[activeProtocol]||'🔬'} ${proto.label||activeProtocol}</div>
      <div class="wiz-sub">${data&&data.complete ? '✅ Assessment complete' : `Step ${protocolStepIdx+1} of ${steps.length||'?'}`} · ${proto.age_group||''}</div>
      <div class="wiz-steps">${stepsHtml}</div>
    </div>`;
}

function setView(v) {
  document.querySelectorAll('.nav-pill').forEach((p,i) => p.classList.toggle('active', ['chat','protocol'][i]===v));
  if (v==='protocol') switchTab('wizard');
}

function setupKW() { $('kwChips').innerHTML = KW_LIST.map(k=>`<div class="kw" onclick="insertKW('${k}')">${k}</div>`).join(''); }
function insertKW(kw) { const ta=$('nepaliInput'), v=ta.value, s=ta.selectionStart; ta.value=v.slice(0,s)+(v.slice(0,s)&&!v.slice(0,s).endsWith(' ')?' ':'')+kw+(v.slice(s)?' ':'')+v.slice(s); ta.focus(); }
function useHint(el) { setMode('text'); $('nepaliInput').value=el.textContent; $('nepaliInput').focus(); }
function handleTK(e) { if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendText();} }

function setMode(m) {
  currentMode = m;
  const modeMap = {voice:'voicePanel', text:'textPanel', file:'filePanel'};
  ['voice','text','file'].forEach(x => {
    $('tab'+x.charAt(0).toUpperCase()+x.slice(1)).classList.toggle('active', x===m);
    const p = $(modeMap[x]);
    if (x==='voice') { p.style.display = m==='voice'?'flex':'none'; }
    else { p.className = x+'-panel'+(m===x?' active':''); }
  });
}

let toastT=null;
function toast(msg,err=false,ms=3000) { const t=$('toast'); t.textContent=msg; t.className='toast on'+(err?' err':''); clearTimeout(toastT); toastT=setTimeout(()=>t.className='toast',ms); }
function setStatus(m,s) { $('statusMain').textContent=m; $('statusSub').textContent=s||''; }

function switchTab(id) {
  const tabs=['referral','wizard','analytics','log'];
  document.querySelectorAll('.ptab').forEach((t,i)=>t.classList.toggle('active',tabs[i]===id));
  document.querySelectorAll('.tab-body').forEach(b=>b.classList.remove('active'));
  $('tab-'+id).classList.add('active');
  if(id==='analytics'||id==='log') loadAnalytics();
}

function startWave(stream) {
  audioCtx = new(window.AudioContext||window.webkitAudioContext)(); analyser = audioCtx.createAnalyser(); analyser.fftSize=256;
  audioCtx.createMediaStreamSource(stream).connect(analyser);
  const bars = Array.from({length:8},(_,i)=>$('b'+i)); const data = new Uint8Array(analyser.frequencyBinCount);
  $('waveform').classList.add('on');
  waveInt = setInterval(()=>{ analyser.getByteFrequencyData(data); bars.forEach((b,i)=>b.style.height=(3+(data[Math.floor(i*data.length/8)]/255)*18)+'px'); }, 55);
}
function stopWave() { clearInterval(waveInt); $('waveform').classList.remove('on'); if(audioCtx){audioCtx.close();audioCtx=null;} Array.from({length:8},(_,i)=>$('b'+i)).forEach(b=>b.style.height='3px'); }

async function toggleRec(){if(isProcessing)return;isRecording?stopRec():await startRec();}
async function startRec() {
  if(currentAudio){currentAudio.pause();currentAudio=null;}
  if(window.speechSynthesis)window.speechSynthesis.cancel();
  try {
    micStream=await navigator.mediaDevices.getUserMedia({audio:true});
    mediaRecorder=new MediaRecorder(micStream,{mimeType:'audio/webm'}); audioChunks=[];
    mediaRecorder.ondataavailable=e=>{if(e.data.size>0)audioChunks.push(e.data);};
    mediaRecorder.onstop=()=>handleAudioStop(new Blob(audioChunks,{type:'audio/webm'}),'recording.webm');
    mediaRecorder.start(100); isRecording=true; seconds=0;
    $('micBtn').className='mic-btn recording'; $('recTimer').textContent='0:00'; $('recTimer').classList.add('on');
    setStatus('Recording...','बोल्दै जानुहोस् · Speak clearly'); startWave(micStream);
    timerInt=setInterval(()=>{seconds++;$('recTimer').textContent=`${Math.floor(seconds/60)}:${String(seconds%60).padStart(2,'0')}`;},1000);
  } catch { toast('Mic denied. Use HTTPS for LAN.',true); }
}
function stopRec(){ clearInterval(timerInt); stopWave(); mediaRecorder.stop(); micStream.getTracks().forEach(t=>t.stop()); isRecording=false; $('recTimer').classList.remove('on'); $('micBtn').className='mic-btn processing'; setStatus('Processing...',''); }

function dOver(e){e.preventDefault();$('dropZone').classList.add('over');}
function dLeave(){$('dropZone').classList.remove('over');}
function dDrop(e){e.preventDefault();$('dropZone').classList.remove('over');const f=e.dataTransfer.files[0];if(f&&f.type.startsWith('audio/'))setFileSel(f);else toast('Audio file needed.',true);}
function fileSel(e){const f=e.target.files[0];if(f)setFileSel(f);}
function setFileSel(f){selectedFile=f;$('fselNm').textContent=f.name+` (${(f.size/1024).toFixed(0)}KB)`;$('fileSel').classList.add('show');}
function clearFile(){selectedFile=null;$('fileIn').value='';$('fileSel').classList.remove('show');}
async function sendFile(){
  if(!selectedFile||isProcessing)return; isProcessing=true; hideEmpty();
  addBubble('user',`📁 ${selectedFile.name}`,[]);
  const thinkId=addThinking(); const form=new FormData();
  form.append('audio',selectedFile,selectedFile.name); form.append('history',JSON.stringify(conversationHistory)); form.append('input_type','audio');
  try{await processForm(form,thinkId);}finally{isProcessing=false;clearFile();}
}

async function sendText(){
  const text=$('nepaliInput').value.trim(); if(!text||isProcessing)return;
  isProcessing=true; hideEmpty(); $('nepaliInput').value='';
  addBubble('user',text,[],false,null,'text');
  const thinkId=addThinking(); const form=new FormData();
  form.append('input_type','text'); form.append('text_input',text); form.append('history',JSON.stringify(conversationHistory));
  try{await processForm(form,thinkId,'text');}finally{isProcessing=false;}
}

async function handleAudioStop(blob,filename){
  isProcessing=true; hideEmpty(); addBubble('user','🎙 ···',[]);
  const form=new FormData(); form.append('audio',blob,filename); form.append('history',JSON.stringify(conversationHistory)); form.append('input_type','audio');
  const thinkId=addThinking();
  try{await processForm(form,thinkId,'voice');}finally{isProcessing=false;$('micBtn').className='mic-btn idle';}
}

async function processForm(form, thinkId, inputType) {
  try {
    const resp = await fetch('/chat',{method:'POST',body:form});
    if(!resp.ok){const e=await resp.json().catch(()=>({}));throw new Error(e.error||`HTTP ${resp.status}`);}
    const data = await resp.json();
    removeEl(thinkId);
    const pred=data.prediction||''; const isAI=data.provider==='groq';
    const ttsLabel=TTS_MAP[data.tts_provider]||data.tts_provider;
    const tags=[];
    if(pred)tags.push({t:pred,tx:`${pred==='low'?'🟢':pred==='medium'?'🟡':'🔴'} ${pred.toUpperCase()}`});
    if(isAI)tags.push({t:'groq',tx:'⚡ Groq'});else tags.push({t:'svm',tx:'📊 SVM'});
    if(data.tts_provider&&data.tts_provider!=='none')tags.push({t:ttsLabel.includes('ElevenLabs')?'el':'gtts',tx:ttsLabel});
    if(data.protocol_result&&data.protocol_result.detected){ tags.push({t:'proto',tx:'🩺 '+data.protocol_result.detected}); autoShowProtocolWizard(data.protocol_result); }
    addBubble('ai', data.answer, tags, !isAI);
    if(isAI){ conversationHistory.push({role:'user',content:data.transcript||'(audio)'}); conversationHistory.push({role:'assistant',content:data.answer}); if(conversationHistory.length>12)conversationHistory=conversationHistory.slice(-12); }
    if(data.referral)renderReferral(data.referral);
    $('speakWave').classList.add('on'); setStatus(`Speaking... (${ttsLabel})`,'');
    await playVoice(data.voice_url, data.answer);
    loadAnalytics();
  } catch(e) {
    removeEl(thinkId); toast('Error: '+e.message, true); setStatus('Press mic to speak',''); $('micBtn').className='mic-btn idle';
  }
}

function autoShowProtocolWizard(protoResult) {
  if(!protoResult||!protoResult.detected) return;
  document.querySelectorAll('.proto-item').forEach(p=>p.classList.remove('active'));
  const pi=$('pi-'+protoResult.detected); if(pi) pi.classList.add('active');
  $('wizEmpty').style.display='none'; $('wizContent').style.display='block';
  const proto=allProtocols[protoResult.detected]||{};
  $('wizContent').innerHTML=`<div class="wiz-card"><div class="wiz-title">${PROTO_ICONS[protoResult.detected]||'🔬'} ${proto.label||protoResult.detected}</div><div class="wiz-sub">Auto-detected · Click sidebar to run full wizard</div></div>`;
}

function hideEmpty(){const e=$('emptyState');if(e)e.style.display='none';}
function addBubble(role,text,tags=[],isSVM=false,extra=null,inputType=null,customHtml=null) {
  const id='m'+(++msgN); const av=role==='user'?'🧑':isSVM?'📊':'⚡';
  const roleCls=role==='ai'?(isSVM?' svm':''):role==='proto'?' proto':'';
  const tagHtml=tags.map(t=>`<span class="tag t-${t.t}">${t.tx}</span>`).join('');
  const bodyHtml = customHtml || `<div class="bubble">${esc(text)}</div>`;
  $('chatFeed').insertAdjacentHTML('beforeend',`
    <div class="msg ${role}${roleCls}" id="${id}">
      <div class="avatar">${av}</div>
      <div class="msg-body">${bodyHtml}<div class="msg-footer">${tagHtml}<span class="mtime">${now()}</span></div></div>
    </div>`);
  scrollBot(); return id;
}
function addThinking(){
  const id='t'+(++msgN);
  $('chatFeed').insertAdjacentHTML('beforeend',`<div class="msg ai" id="${id}"><div class="avatar">⚡</div><div class="msg-body"><div class="thinking"><div class="tdot"></div><div class="tdot"></div><div class="tdot"></div></div></div></div>`);
  scrollBot(); return id;
}
function removeEl(id){const e=$(id);if(e)e.remove();}
function scrollBot(){const c=$('chatFeed');requestAnimationFrame(()=>c.scrollTop=c.scrollHeight);}
function esc(t){return(t||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function now(){return new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});}
function clearChat(){
  conversationHistory=[]; $('chatFeed').querySelectorAll('.msg').forEach(m=>m.remove());
  const e=$('emptyState');if(e)e.style.display='';
  stopProtoAudio(); if(currentAudio){currentAudio.pause();currentAudio=null;}
  setStatus('Press mic to speak','बोल्न सुरु गर्नुहोस्');
}

function renderReferral(ref) {
  if(!ref)return; $('refContent').style.display='block'; $('refEmpty').style.display='none';
  const h=ref.hospital, beds=h.beds; const riskC=ref.risk==='critical'||ref.risk==='high'?'high':ref.risk;
  const bedCls=beds.status==='Available'?'hb-ok':beds.status==='Limited'?'hb-ltd':'hb-full';
  const bedTxt=beds.status==='Full'?'🔴 Full':beds.status==='Limited'?`🟡 ${beds.free} beds`:`🟢 ${beds.free} free`;
  const specsHtml=(h.specialties||[]).map(s=>`<span class="hsp">${esc(s)}</span>`).join('');
  const actHtml=(ref.actions||[]).map(a=>`<div class="ref-act${a.urgent?' urg':''}" onclick="handleAct('${esc(a.type)}','${esc(a.sub)}','${esc(a.label)}')"><div class="ra-ic">${a.icon}</div><div class="ra-tx"><div class="ra-lb">${esc(a.label)}</div><div class="ra-sb">${esc(a.sub)}</div></div><div class="ra-arr">›</div></div>`).join('');
  const altHtml=ref.alternate?`<div class="ref-alt"><strong>Alternate:</strong> ${esc(ref.alternate.name)} · ${ref.alternate.distance}km · ${esc(ref.alternate.contact)}</div>`:'';
  const protoBox = ref.protocol_result&&ref.protocol_result.detected?`<div class="reas-box"><div class="reas-lbl">🩺 IMNCI Protocol</div><div class="reas-txt">${esc(ref.protocol_result.detected)}</div></div>`:'';
  $('refContent').innerHTML=`
    <div class="urg-banner ${riskC}"><div class="urg-icon">${riskC==='high'?'🔴':riskC==='medium'?'🟡':'🟢'}</div><div><div class="urg-label">${ref.urgency.label}</div><div class="urg-ne">${esc(ref.urgency.ne)}</div></div></div>
    ${protoBox}
    <div class="reas-box"><div class="reas-lbl">Clinical Reason</div><div class="reas-txt">${esc(ref.reason_ne)}</div></div>
    <div class="hosp-card">
      <div class="hosp-name">${esc(h.name)}</div>
      <div class="hosp-bgs">${h.emergency?'<span class="hb hb-e">🚨 Emergency</span>':''}${h.ambulance?'<span class="hb hb-a">🚑 Ambulance</span>':''}<span class="hb ${bedCls}">${bedTxt}</span></div>
      <div class="hosp-stats"><div class="hs"><div class="hs-v">${h.distance}km</div><div class="hs-l">Distance</div></div><div class="hs"><div class="hs-v">${esc(ref.travel.hours_mins)}</div><div class="hs-l">${esc(ref.travel.mode)}</div></div><div class="hs"><div class="hs-v">${beds.free}</div><div class="hs-l">Beds free</div></div></div>
      <div class="hosp-ct">📞 ${esc(h.contact)} · ${esc(h.district)}</div>
      <div class="hosp-rd">🛣️ ${esc(ref.road_condition)}</div>
      <div class="hosp-sp">${specsHtml}</div>${altHtml}
    </div>
    <div class="ref-acts">${actHtml}</div>`;
  switchTab('referral');
}
function handleAct(type,detail,label){ if(type==='call') toast(`📞 ${label}: ${detail}`,false,3000); else toast(`✓ ${label}`,false,2000); }

async function loadAnalytics() {
  try {
    const d=await fetch('/data').then(r=>r.json());
    const total=d.total||0, c=d.counts||{low:0,medium:0,high:0};
    const low=c.low||0, med=c.medium||0, high=c.high||0;
    $('sTotal').textContent=total; $('sMs').textContent=d.avg_ms?d.avg_ms+'ms':'—'; $('sAI').textContent=d.ai_online||0;
    const mx=Math.max(low,med,high,1);
    $('rL').style.width=(low/mx*100)+'%'; $('rLN').textContent=low;
    $('rM').style.width=(med/mx*100)+'%'; $('rMN').textContent=med;
    $('rH').style.width=(high/mx*100)+'%'; $('rHN').textContent=high;
    const circ=138;
    if(total>0){ const lp=low/total*circ,mp=med/total*circ,hp=high/total*circ; $('doL').style.strokeDasharray=`${lp} ${circ-lp}`; $('doL').style.strokeDashoffset=`${-lp-mp}`; $('doM').style.strokeDasharray=`${mp} ${circ-mp}`; $('doM').style.strokeDashoffset=`${-lp}`; $('doH').style.strokeDasharray=`${hp} ${circ-hp}`; $('doH').style.strokeDashoffset='0'; }
    $('doC').textContent=total; $('dlL').textContent=low; $('dlM').textContent=med; $('dlH').textContent=high;
    $('kT').textContent=total; $('kA').textContent=d.avg_ms?d.avg_ms+'ms':'—'; $('kAI').textContent=d.ai_online||0; $('kSV').textContent=d.svm_offline||0;
    const daily=d.daily||{}, days=Object.entries(daily), bc=$('barChart');
    if(!days.length){bc.innerHTML='<div style="font-size:10px;color:var(--muted);text-align:center;width:100%">No data</div>';}
    else{const mx2=Math.max(...days.map(([,v])=>v),1);bc.innerHTML=days.map(([day,val])=>`<div class="bar-col"><div class="bar-fill2" style="height:${Math.max(2,Math.round(val/mx2*44))}px"></div><div class="bar-lbl2">${day.slice(5)}</div></div>`).join('');}
    const bp=d.by_protocol||{}, psEl=$('protoStats');
    if(!Object.keys(bp).length){psEl.innerHTML='<div style="font-size:11px;color:var(--muted)">No protocol data yet.</div>';}
    else{psEl.innerHTML=Object.entries(bp).sort(([,a],[,b])=>b-a).map(([k,v])=>`<div class="ps-row"><span class="ps-nm">${PROTO_ICONS[k]||'🔬'} ${k}</span><span class="ps-v">${v}</span></div>`).join('');}
    const logEl=$('logList');
    if(!d.recent||!d.recent.length){logEl.innerHTML='<div style="font-size:11.5px;color:var(--muted);padding:8px">No sessions yet.</div>';return;}
    logEl.innerHTML=d.recent.map(e=>{ const pred=e.prediction||'medium'; const tm=(e.timestamp||'').slice(11,16); const txt=(e.answer||'').slice(0,50); const pt=e.protocol?`<span class="lproto">${PROTO_ICONS[e.protocol]||'🔬'}</span>`:''; return`<div class="log-item"><div class="log-top"><div class="ldot ${pred}"></div><div class="lpred ${pred}">${pred.toUpperCase()}</div>${pt}<div class="ltime">${tm}</div></div><div class="ltxt">${esc(txt)}</div></div>`; }).join('');
  } catch(e){console.warn('Analytics:',e);}
}

async function playVoice(url, fallback) {
  const done=()=>{$('speakWave').classList.remove('on');setStatus('Press mic to speak','बोल्न सुरु गर्नुहोस्');};
  if(url){ currentAudio=new Audio(url); currentAudio.onended=done; currentAudio.onerror=()=>browserTTS(fallback,done); try{await currentAudio.play();return;}catch{} }
  browserTTS(fallback,done);
}
function browserTTS(text,done){
  if(!window.speechSynthesis){done&&done();return;}
  const u=new SpeechSynthesisUtterance(text); u.lang='ne-NP'; u.rate=.87;
  const voices=window.speechSynthesis.getVoices();
  const v=voices.find(v=>v.lang.startsWith('ne'))||voices.find(v=>v.lang.startsWith('hi'))||voices[0];
  if(v)u.voice=v; u.onend=u.onerror=done||(()=>{});
  window.speechSynthesis.speak(u);
}

window.speechSynthesis&&window.speechSynthesis.getVoices();
init();
</script>
