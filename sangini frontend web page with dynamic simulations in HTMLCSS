(function(){
  var root=document.documentElement,btn=document.getElementById('themeToggle');
  var mq=window.matchMedia('(prefers-color-scheme: dark)');
  function current(){return root.getAttribute('data-theme')||(mq.matches?'dark':'light')}
  function paint(){
    var t=current();
    document.getElementById('themeIcon').textContent=t==='dark'?'☀':'☾';
    document.getElementById('themeLabel').textContent=t==='dark'?'Light':'Dark';
  }
  try{var s=localStorage.getItem('sangini-theme');if(s==='light'||s==='dark')root.setAttribute('data-theme',s)}catch(e){}
  btn.addEventListener('click',function(){
    var next=current()==='dark'?'light':'dark';
    root.setAttribute('data-theme',next);
    try{localStorage.setItem('sangini-theme',next)}catch(e){}
    paint();
  });
  paint();
})();
</script>
<script>
(function(){
var $=function(i){return document.getElementById(i)},sim=$('demo');
var D={
routine:{text:'Sita, 24 years, five months pregnant. Second ANC visit. Feeling [well], baby is [moving]. Blood pressure [110] over 70.',rows:[['Patient','Sita, 24'],['Gestation','~22 weeks'],['Visit','ANC 2'],['BP','110/70'],['Danger signs','None'],['Action','Next visit in 4 weeks']],risk:false,alert:'Routine visit. No danger signs. Next ANC booked in 4 weeks.',chip:'ANC 2 · Routine'},
danger:{text:'Maya, 29 years, eight months pregnant. Fourth ANC visit. [Severe] [headache] and [blurred] vision since morning, face is [swollen.] Blood pressure [150] over 100.',rows:[['Patient','Maya, 29'],['Gestation','~34 weeks'],['Visit','ANC 4'],['BP','150/100'],['Danger signs','Headache, blurred vision, swelling'],['Action','Refer today']],risk:true,alert:'High risk: possible pre-eclampsia. Refer to facility now.',chip:'Danger sign → Referral'}};
var cur='danger',recs=[],synced=0,T=[],iv=null,playing=false,syncT=null,wave=$('wave');
for(var i=0;i<28;i++){var b=document.createElement('span');b.style.setProperty('--d',(-Math.random()*.9).toFixed(2)+'s');wave.appendChild(b)}
function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
function cards(a,b,c){[$('c1'),$('c2'),$('c3')].forEach(function(n,i){n.classList.toggle('on',!![a,b,c][i])})}
function stop(){T.forEach(clearTimeout);T=[];clearInterval(iv);playing=false;$('simPlay').disabled=false;wave.classList.remove('on');cards(0,0,0)}
function clearView(){stop();$('say').textContent='Press play to hear the visit.';var r=$('rows');r.textContent='';D[cur].rows.forEach(function(x){var d=el('div','row');d.appendChild(el('span',null,x[0]));d.appendChild(el('span','v','—'));r.appendChild(d)});var a=$('alert');a.className='alert';a.textContent='Waiting for a visit…';$('hand').textContent='';$('hand').className='hand'}
function fill(n){var row=$('rows').children[n];row.querySelector('.v').textContent=D[cur].rows[n][1];row.classList.add('in')}
function status(){clearTimeout(syncT);var n=recs.length,p=n-synced,dot=$('dot'),st=$('stat');
if(!n){dot.className='';st.textContent='Ready. Nothing recorded yet.';return}
if(!p){dot.className='dot-ok';st.textContent='All '+n+' synced to the cloud.';return}
if($('simOff').checked){dot.className='dot-wait';st.textContent='Saved on device. '+p+' waiting to sync.';return}
dot.className='dot-wait';st.textContent='Syncing '+p+'…';
syncT=setTimeout(function(){if(!$('simOff').checked){synced=recs.length;status()}},1400)}
function finish(){var d=D[cur];wave.classList.remove('on');cards(0,0,1);var a=$('alert');a.className='alert '+(d.risk?'risk':'ok');a.textContent=(d.risk?'⚠ ':'✓ ')+d.alert;recs.push(d);$('tl').appendChild(el('span','c '+(d.risk?'risk':'ok'),d.chip));var h=$('hand');h.textContent=d.risk?'Referral handoff: '+recs.length+' visit'+(recs.length>1?'s':'')+' of history travel with her.':'Added to the timeline. Nothing to hand off.';h.className='hand'+(d.risk?' risk':'');playing=false;$('simPlay').disabled=false;status()}
function play(){if(playing)return;clearView();playing=true;$('simPlay').disabled=true;wave.classList.add('on');cards(1,1,0);
var say=$('say');say.textContent='';var ws=D[cur].text.split(' '),i=0,f=0,th=[.2,.35,.45,.7,.85,1];
iv=setInterval(function(){var w=ws[i++],s=el('span','w');
if(w.charAt(0)=='['){var k=w.indexOf(']');s.appendChild(el('span','kw',w.slice(1,k)));s.appendChild(document.createTextNode(w.slice(k+1)))}else s.textContent=w;
say.appendChild(s);say.appendChild(document.createTextNode(' '));
while(f<6&&i/ws.length>=th[f])fill(f++);
if(i>=ws.length){clearInterval(iv);T.push(setTimeout(finish,500))}},190)}
var sb=sim.querySelectorAll('[data-s]');
sb.forEach(function(b){b.addEventListener('click',function(){cur=b.getAttribute('data-s');sb.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false')});clearView()})});
$('simPlay').addEventListener('click',play);
$('simReset').addEventListener('click',function(){stop();recs=[];synced=0;$('tl').textContent='';clearView();status()});
$('simOff').addEventListener('change',status);
var Z=[.85,1,1.15,1.3,1.5],zi=1;
function zoom(d){zi=Math.max(0,Math.min(Z.length-1,zi+d));sim.style.setProperty('--s',Z[zi]);$('szVal').textContent=Math.round(Z[zi]*100)+'%';$('szDn').disabled=zi==0;$('szUp').disabled=zi==Z.length-1}
$('szDn').addEventListener('click',function(){zoom(-1)});$('szUp').addEventListener('click',function(){zoom(1)});
clearView();status();zoom(0);
})();
</script>
